# Copy to .env and fill in for your environment. Never commit the real .env.
AWS_REGION=us-east-1
# OLLAMA_URL is no longer used (the old raw /api/generate call was replaced
# by the agent's tool-calling chat client) -- kept here as a comment so an
# old .env with this key doesn't break anything. Use OLLAMA_BASE_URL instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=8
AGENT_MAX_STEPS=6
API_KEY=
MOCK_ON_FAILURE=true
